pkgname=mpvpaper
pkgver=1.9
pkgrel=1
pkgdesc='Play videos as the wallpaper on a Wayland desktop'
arch=(x86_64)
url='https://github.com/GhostNaN/mpvpaper'
license=(GPL-3.0-only)
depends=(mpv wayland libglvnd)
makedepends=(meson ninja wayland-protocols)
options=(!debug)
source=("$pkgname-$pkgver.tar.gz::https://codeload.github.com/GhostNaN/mpvpaper/tar.gz/refs/tags/$pkgver")
sha256sums=('6de941b54941cfd5d00bac62d10ef47c1338f237dac4c78a7185d0f8d30cd4d1')

build() {
    arch-meson "$pkgname-$pkgver" build
    meson compile -C build
}

package() {
    meson install -C build --destdir "$pkgdir"
    install -Dm644 "$pkgname-$pkgver/mpvpaper.man" "$pkgdir/usr/share/man/man1/mpvpaper.1"
    install -Dm644 "$pkgname-$pkgver/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
